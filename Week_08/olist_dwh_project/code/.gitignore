# .gitignore
# Files and folders excluded from version control

# Environment variables (contains passwords)
.env

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
venv/
env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Source database - do not commit binary data
data/olist.sqlite