# Lightweight Operations Console. It intentionally does not include Docker CLI or Docker socket access.
FROM python:3.12-slim

WORKDIR /opt/observability

COPY observability_ui/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY observability_ui /opt/observability

EXPOSE 8501

CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true", "--browser.gatherUsageStats=false"]
