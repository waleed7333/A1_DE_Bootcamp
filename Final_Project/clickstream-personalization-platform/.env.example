# Copy this file to .env before the first run. Do not commit .env.
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_PORT=5433

# MinIO: Iceberg data files are stored in this local object store.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=ecommerce-lakehouse
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Kafka host ports. Internal container ports are configured in docker-compose.yml.
KAFKA1_HOST_PORT=29092
KAFKA2_HOST_PORT=29093
KAFKA3_HOST_PORT=29094
KAFKA_UI_PORT=8080
DEBEZIUM_PORT=8083
AIRFLOW_PORT=8081
OBSERVABILITY_PORT=8501

# Airflow runs as one all-in-one development service in this project.

# ClickHouse serving layer. Native port 9002 deliberately avoids MinIO ports 9000/9001.
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9002
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_PASSWORD

# Required for Holiday enrichment. Open-Meteo does not need a key.
CALENDARIFIC_API_KEY=CHANGE_ME_CALENDARIFIC_KEY
GEOIP_DATABASE_PATH=data/reference/GeoLite2-City.mmdb

# Spark driver limits inside the single spark-engine container.
SPARK_DRIVER_MEMORY=1600m
SPARK_EXECUTOR_MEMORY=1600m
